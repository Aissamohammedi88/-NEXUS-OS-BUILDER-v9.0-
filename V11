use std::fs::File;
use std::io::{self, Read};
use sha2::{Sha256, Digest};
use serde::{Serialize, Deserialize};

#[derive(Serialize, Deserialize, Debug)]
pub struct IntegrityReport {
    pub file_path: String,
    pub sha256_hash: String,
    pub verified: bool,
}

/// Calcule le empreinte SHA-256 d'un fichier de manière optimisée par blocs.
pub fn compute_file_sha256(path: &str) -> io::Result<String> {
    let mut file = File::open(path)?;
    let mut hasher = Sha256::new();
    let mut buffer = [0u8; 8192];

    loop {
        let count = file.read(&mut buffer)?;
        if count == 0 {
            break;
        }
        hasher.update(&buffer[..count]);
    }

    let result = hasher.finalize();
    Ok(format!("{:x}", result))
}

pub fn verify_artifact(path: &str, expected_hash: &str) -> IntegrityReport {
    match compute_file_sha256(path) {
        Ok(hash) => {
            let matches = hash == expected_hash;
            IntegrityReport {
                file_path: path.to_string(),
                sha256_hash: hash,
                verified: matches,
            }
        }
        Err(_) => IntegrityReport {
            file_path: path.to_string(),
            sha256_hash: String::from("ERREUR_LECTURE"),
            verified: false,
        },
    }
}
