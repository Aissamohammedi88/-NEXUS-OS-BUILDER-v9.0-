def find_base() -> Path:
    """Retourne le premier dossier de travail inscriptible."""
    import os

    candidates = [
        os.getenv("NEXUS_DIR"),
        os.path.expanduser("~/nexus_build"),
        os.path.join(tempfile.gettempdir(), "nexus_build"),
        os.path.expanduser("~/Documents/nexus_build"),
        os.path.join(os.getcwd(), "nexus_build"),
    ]
    for candidate in candidates:
        if not candidate:
            continue
        try:
            path = Path(candidate)
            path.mkdir(parents=True, exist_ok=True)
            probe = path / ".probe"
            probe.write_text("ok", encoding="utf-8")
            probe.unlink()
            return path
        except OSError:
            continue
    raise RuntimeError("Aucun dossier inscriptible trouvé")


BASE = find_base()
LOGS = BASE / "logs"
EXPORTS = BASE / "exports"
BUILDS = BASE / "builds"
