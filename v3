# ═══════════════════════════════════════════════════════════════════
# ÉTAPES DU BUILD
# ═══════════════════════════════════════════════════════════════════

StepFunc = Callable[[Project, Path], None]


def step_structure(project: Project, rootfs: Path) -> None:
    for folder in ROOT_DIRS:
        (rootfs / folder).mkdir(parents=True, exist_ok=True)


def step_init(project: Project, rootfs: Path) -> None:
    content = INIT_TEMPLATE.format(
        name=project.name,
        built=datetime.now().isoformat(),
        distro=project.distro,
        version=VERSION,
    )
    write_file(rootfs, "init", content, mode=0o755)


def step_shell(project: Project, rootfs: Path) -> None:
    write_file(rootfs, "bin/sh", SHELL_TEMPLATE, mode=0o755)


def step_system_files(project: Project, rootfs: Path) -> None:
    now = datetime.now().isoformat()
    files = {
        "etc/passwd": "root:x:0:0:root:/root:/bin/sh\n"
                      "nexus:x:1000:1000:Nexus:/home/nexus:/bin/sh\n"
                      "nobody:x:65534:65534:nobody:/:/bin/false\n",
        "etc/group": "root:x:0:\nnexus:x:1000:\nwheel:x:10:nexus\nnobody:x:65534:\n",
        "etc/shadow": "root:*:19000:0:99999:7:::\nnexus:*:19000:0:99999:7:::\n",
        "etc/hostname": f"nexus-{project.id}\n",
        "etc/hosts": "127.0.0.1\tlocalhost\n127.0.1.1\tnexus\n",
        "etc/resolv.conf": "nameserver 1.1.1.1\nnameserver 8.8.8.8\n",
        "etc/fstab": "proc /proc proc defaults 0 0\n"
                     "sysfs /sys sysfs defaults 0 0\n"
                     "devtmpfs /dev devtmpfs defaults 0 0\n",
        "etc/issue": f"NEXUS OS v{VERSION} - {project.name}\n",
        "etc/profile": "export PATH=/bin:/sbin:/usr/bin:/usr/sbin\nexport HOME=/root\n",
        "etc/nexus-release": (
            f"NEXUS OS v{VERSION}\nName: {project.name}\n"
            f"Distro: {project.distro}\nBuilt: {now}\n"
        ),
    }
    for relative, content in files.items():
        mode = 0o600 if "shadow" in relative else None
        write_file(rootfs, relative, content, mode=mode)


def step_tools(project: Project, rootfs: Path) -> None:
    content = NEXUS_INFO_TEMPLATE.format(
        version=VERSION,
        name=project.name,
        distro=project.distro,
        built_short=datetime.now().strftime("%Y-%m-%d %H:%M"),
    )
    write_file(rootfs, "bin/nexus-info", content, mode=0o755)


def step_readme(project: Project, rootfs: Path) -> None:
    content = README_TEMPLATE.format(
        version=VERSION,
        name=project.name,
        distro=project.distro,
        prompt=project.prompt,
    )
    write_file(rootfs, "README.txt", content)


def step_archive(project: Project, rootfs: Path) -> None:
    archive_path = EXPORTS / f"{project.name}_{project.id}.tar.xz"
    with tarfile.open(archive_path, "w:xz", preset=6) as tar:
        tar.add(rootfs, arcname="rootfs")
        tar.add(rootfs / "README.txt", arcname="README.txt")
    project.archive = str(archive_path)
    project.size_kb = archive_path.stat().st_size // 1024


def step_stats(project: Project, rootfs: Path) -> None:
    project.files_count = sum(1 for item in rootfs.rglob("*") if item.is_file())
    project.add_log(f"Archive: {project.size_kb} KB, {project.files_count} fichiers")


# Étapes déclarées : (progression, libellé, fonction, message de journal)
BUILD_STEPS: List[tuple] = [
    (10, "Structure rootfs", step_structure, "Création de l'arborescence"),
    (20, "/init", step_init, "Création de /init"),
    (30, "Shell minimal", step_shell, "Création de /bin/sh"),
    (40, "Fichiers système", step_system_files, "Écriture des fichiers /etc"),
    (50, "Outils NEXUS", step_tools, "Création de nexus-info"),
    (60, "README", step_readme, "Écriture du README"),
    (80, "Archive", step_archive, "Création de l'archive .tar.xz"),
    (95, "Stats", step_stats, "Calcul des statistiques"),
]


def build_project(project: Project) -> None:
    """Construit le rootfs puis l'archive. Ne lève jamais d'exception."""
    try:
        project.status = "BUILDING"
        project.add_log(f"Démarrage du build : {project.name}")
        project.add_log(f"Distro : {project.distro}")
        project.add_log(f"Prompt : {project.prompt[:60]}")

        rootfs = BUILDS / project.id / "rootfs"
        rootfs.mkdir(parents=True, exist_ok=True)

        for progress, label, func, message in BUILD_STEPS:
            project.set_step(progress, label)
            project.add_log(message)
            func(project, rootfs)

        project.set_step(100, "Terminé")
        project.status = "COMPLETED"
        project.add_log("Build terminé avec succès")
        project.add_log(f"Téléchargement : /download/{project.id}/archive")

    except Exception as exc:  # noqa: BLE001 - on journalise tout échec de build
        project.status = "FAILED"
        project.error = str(exc)
        project.add_log(f"ERREUR : {exc}")
        log.debug(traceback.format_exc())


# ═══════════════════════════════════════════════════════════════════
# FACTORY
# ═══════════════════════════════════════════════════════════════════

class Factory:
    """Gère la création et le suivi des projets de build."""

    def __init__(self) -> None:
        self.projects: Dict[str, Project] = {}
        self.lock = threading.RLock()

    def create(self, name: str, distro: str, prompt: str) -> Project:
        project_id = str(uuid.uuid4())[:8]
        project = Project(project_id, name, distro, prompt)
        with self.lock:
            self.projects[project_id] = project
        threading.Thread(target=build_project, args=(project,), daemon=True).start()
        return project

    def get(self, project_id: str) -> Optional[Project]:
        with self.lock:
            return self.projects.get(project_id)

    def all(self) -> List[dict]:
        with self.lock:
            return [asdict(p) for p in self.projects.values()]


