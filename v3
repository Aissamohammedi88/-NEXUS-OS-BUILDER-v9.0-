# MODÈLE DE PROJET
# ═══════════════════════════════════════════════════════════════════

@dataclass
class Project:
    id: str
    name: str
    distro: str
    prompt: str
    status: str = "PENDING"
    progress: int = 0
    step: str = ""
    logs: List[str] = field(default_factory=list)
    archive: Optional[str] = None
    size_kb: int = 0
    files_count: int = 0
    error: Optional[str] = None

    def add_log(self, message: str) -> None:
        """Ajoute une entrée horodatée au journal du projet."""
        timestamp = datetime.now().strftime("%H:%M:%S")
        self.logs.append(f"[{timestamp}] {message}")
        log.info("[%s] %s", self.id, message)

    def set_step(self, progress: int, step: str) -> None:
        """Met à jour la progression et le libellé de l'étape courante."""
        self.progress = progress
        self.step = step


# ═══════════════════════════════════════════════════════════════════
# UTILITAIRES DE FICHIERS
# ═══════════════════════════════════════════════════════════════════

def write_file(base: Path, relative: str, content: str, mode: Optional[int] = None) -> Path:
    """Écrit un fichier dans le rootfs, crée les dossiers parents et applique un mode."""
    target = base / relative
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(content, encoding="utf-8", newline="\n")
    if mode is not None:
        target.chmod(mode)
    return target


