def find_base() -> Path:
    """Trouve un dossier de base inscriptible avec plusieurs replis."""
    candidates = [
        os.getenv("NEXUS_DIR"),
        os.path.expanduser("~/nexus_build"),
        os.path.join(tempfile.gettempdir(), "nexus_build"),
        os.path.expanduser("~/Documents/nexus_build"),
        os.path.join(os.getcwd(), "nexus_build")
    ]
    for c in candidates:
        if not c:
            continue
        try:
            p = Path(c)
            p.mkdir(parents=True, exist_ok=True)
            test_file = p / ".t"
            test_file.write_text("x")
            test_file.unlink()
            return p
        except Exception:
            continue
    raise RuntimeError("Aucun dossier inscriptible trouvé pour le stockage")

