#include <iostream>
#include <string>
#include <vector>
#include <fstream>
#include <sstream>
#include <memory>
#include <sys/stat.h>

namespace NexusKernel {

    class SystemBufferManager {
    private:
        size_t capacity;
        std::vector<char> buffer;

    public:
        SystemBufferManager(size_t cap) : capacity(cap) {
            buffer.reserve(capacity);
        }

        bool write_to_disk(const std::string& filepath, const std::string& data) {
            std::ofstream outfile(filepath, std::ios::binary);
            if (!outfile.is_open()) {
                return false;
            }
            outfile.write(data.data(), data.size());
            outfile.close();
            return true;
        }

        std::string read_from_disk(const std::string& filepath) {
            std::ifstream infile(filepath, std::ios::binary);
            if (!infile.is_open()) {
                return "";
            }
            std::stringstream buffer_stream;
            buffer_stream << infile.rdbuf();
            return buffer_stream.str();
        }

        size_t get_capacity() const {
            return capacity;
        }
    };

} // namespace NexusKernel
